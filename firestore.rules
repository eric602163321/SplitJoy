rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- 1. Helper Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }

    // --- 2. Validation Blueprints ---
    function getOwnerId(data) {
      return data.get('ownerId', '') != '' 
        ? data.get('ownerId', '') 
        : (data.get('members', null) is map && 'ownerId' in data.members ? data.members.ownerId : '');
    }
    function getGroupName(data) {
      return data.get('name', '') != '' 
        ? data.get('name', '') 
        : (data.get('members', null) is map && 'name' in data.members ? data.members.name : '');
    }
    function getMemberIds(data) {
      return data.get('memberIds', null) is list 
        ? data.get('memberIds', [])
        : (getOwnerId(data) != '' ? [getOwnerId(data)] : []);
    }
    function isMemberOrOwner(data) {
      return isSignedIn() && (
        getOwnerId(data) == request.auth.uid || 
        getMemberIds(data).hasAny([request.auth.uid])
      );
    }
    function isValidUserData(data) {
      return (data.get('personalExpenses', []) is list) &&
             (data.get('members', []) is list);
    }
    function isValidGroup(data) {
      return getGroupName(data) is string &&
             getOwnerId(data) is string &&
             (getMemberIds(data) is list);
    }

    // --- 3. Collection Rules ---

    // Global deny - but placed correctly to avoid blocking matches
    match /{document=**} {
      allow read, write: if false;
    }

    // User docs (Personal expenses & Members)
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserData(incoming());
      allow update: if isOwner(userId) && isValidUserData(incoming());
    }

    // Shared Groups
    match /groups/{groupId} {
      // Allow single document read (get) for any signed-in user who has the invite code
      allow get: if isSignedIn();
      // Allow querying/listing only if the user is a member
      allow list: if isSignedIn() && isMemberOrOwner(existing());
      
      allow create: if isSignedIn() && 
                    isValidId(groupId) && 
                    getOwnerId(incoming()) == request.auth.uid &&
                    isValidGroup(incoming());
      
      allow update: if isSignedIn() && (
        // Scenario A: Existing member or owner is updating details
        (isMemberOrOwner(existing()) && 
         getOwnerId(incoming()) == getOwnerId(existing()) &&
         isValidGroup(incoming())) ||
        // Scenario B: A new user is joining using the invite code
        (
          // They must add themselves to memberIds
          incoming().get('memberIds', []).hasAny([request.auth.uid]) &&
          // Owner, group name and expenses must remain unchanged (fully backward-compatible)
          getOwnerId(incoming()) == getOwnerId(existing()) &&
          getGroupName(incoming()) == getGroupName(existing()) &&
          incoming().get('expenses', []) == existing().get('expenses', []) &&
          isValidGroup(incoming())
        )
      );
      
      allow delete: if isSignedIn() && getOwnerId(existing()) == request.auth.uid;
    }
  }
}
