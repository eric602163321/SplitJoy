rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isGroupMember(groupId) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/groups/$(groupId)) &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // User documents
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Group documents
    match /groups/{groupId} {
      allow read: if isSignedIn() && (resource.data.ownerId == request.auth.uid || request.auth.uid in resource.data.memberIds);
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid && isValidId(groupId);
      allow update: if isSignedIn() && (
        (resource.data.ownerId == request.auth.uid) || 
        (request.auth.uid in resource.data.memberIds)
      );
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }
  }
}
