rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- 1. Helper Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }

    // --- 2. Validation Blueprints ---
    function getOwnerId(data) {
      return data.get('ownerId', '') != '' 
        ? data.get('ownerId', '') 
        : (data.get('members', null) is map ? data.get(['members', 'ownerId'], '') : '');
    }
    function isValidUserData(data) {
      return (data.get('personalExpenses', []) is list) &&
             (data.get('members', []) is list);
    }
    function isValidGroup(data) {
      return data.id is string &&
             data.name is string &&
             data.ownerId is string &&
             (data.memberIds is list) &&
             (data.get('expenses', []) is list);
    }

    // --- 3. Collection Rules ---

    // Global deny - but placed correctly to avoid blocking matches
    match /{document=**} {
      allow read, write: if false;
    }

    // User docs (Personal expenses & Members)
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserData(incoming());
      allow update: if isOwner(userId) && isValidUserData(incoming());
    }

    // Shared Groups
    match /groups/{groupId} {
      // Allow single document read (get) for any signed-in user who has the invite code
      allow get: if isSignedIn();
      // Allow querying/listing only if the user is a member
      allow list: if isSignedIn() && (
        getOwnerId(existing()) == request.auth.uid || 
        existing().get('memberIds', []).hasAny([request.auth.uid])
      );
      
      allow create: if isSignedIn() && 
                    isValidId(groupId) && 
                    getOwnerId(incoming()) == request.auth.uid;
      
      allow update: if isSignedIn() && (
        // Either they are already a member or the owner
        (getOwnerId(existing()) == request.auth.uid || 
         existing().get('memberIds', []).hasAny([request.auth.uid])) ||
        // Or they are joining: adding themselves to memberIds, and ownerId remains unchanged
        (incoming().get('memberIds', []).hasAny([request.auth.uid]) && 
         getOwnerId(incoming()) == getOwnerId(existing()))
      );
      
      allow delete: if isSignedIn() && getOwnerId(existing()) == request.auth.uid;
    }
  }
}
